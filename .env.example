NODE_ENV=development
HOST=127.0.0.1
PORT=3001
FRONTEND_ORIGIN=http://localhost:3000
# In production omission disables /api/v1/admin/*; use the exact HTTPS admin origin.
ADMIN_FRONTEND_ORIGIN=http://localhost:3002
# Exact IPv4/IPv6 addresses, comma-separated. Empty = no IP restriction (auth/MFA still required).
# Applies only to /api/v1/admin endpoints. Example: 192.0.2.10,2001:db8::10
ADMIN_ALLOWED_IPS=
LOG_LEVEL=info
# Optional release tag stored with bounded operational telemetry.
# APP_VERSION=0.0.0
# Use a dedicated application role, never meal_owner or a superuser.
# Local direct role: postgresql://meal_app:LOCAL_SECRET@127.0.0.1:15432/meal_planner_postgres
# Server login/effective-role form: postgresql://meal_runtime:SECRET@postgres:5432/meal_planner_postgres?options=-c%20role%3Dmeal_app
# For Docker secrets use an absolute path instead; never configure both forms.
# DATABASE_URL_FILE=/run/secrets/backend_database_url
DATABASE_POOL_SIZE=10
# Host/container metrics are disabled unless both values are present. Production accepts only this fixed path.
OBSERVABILITY_HOST_SNAPSHOT_ENABLED=false
# OBSERVABILITY_HOST_SNAPSHOT_FILE=/run/meal-observability/current.json
WORKER_OWNER_ID=meal-worker-1
# Enable only after approved database deployment and application grants.
# Creates in-app cooking reminders and archives expired unfinished attempts; no push/email delivery.
COOKING_LIFECYCLE_ENABLED=false
# Required for auth. Generate independently with crypto.randomBytes(32).toString('base64').
# SECURITY_KEY=
# MFA_ENCRYPTION_KEY=
# SECURITY_KEY_FILE=/run/secrets/backend_security_key
# MFA_ENCRYPTION_KEY_FILE=/run/secrets/backend_mfa_encryption_key
# Legal manifests and events default to approved evidence and never fall back to placeholders.
# Use demonstration only in an explicitly isolated technical environment; it is honored even with NODE_ENV=production.
LEGAL_EVIDENCE_MODE=approved
# Emergency operator CLI only. Keep false in the long-running backend/worker environment;
# set true for one explicit `admin:mfa-recover --execute` invocation and remove immediately afterwards.
ADMIN_RECOVERY_ENABLED=false
# Deployment-only switch: starts the private local S3-compatible provider without enabling user uploads.
# MEDIA_STORAGE_INFRA_ENABLED=false
# SEAWEEDFS_IMAGE=ghcr.io/chrislusf/seaweedfs@sha256:<immutable-digest>
# Provider-neutral S3-compatible media API. Keep false during checkpoint 6A even when the provider is running:
# target binding, quotas and scanner/manual-review promotion are separate gates.
MEDIA_STORAGE_ENABLED=false
# Legacy in-process Tesseract/sharp scan. Keep false in production; the isolated processor replaces it.
INLINE_INGEST_OCR_ENABLED=false
# MEDIA_STORAGE_ENDPOINT=http://seaweedfs
# MEDIA_STORAGE_BACKEND_PORT=8333
# MEDIA_STORAGE_REGION=us-east-1
# MEDIA_STORAGE_ACCESS_KEY_ID=meal-backend
# MEDIA_STORAGE_SECRET_ACCESS_KEY_FILE=/run/secrets/media_storage_secret_access_key
# MEDIA_STORAGE_QUARANTINE_BUCKET=meal-media-quarantine
# MEDIA_STORAGE_READY_BUCKET=meal-media-ready
# MEDIA_STORAGE_PREFIX=meal
# MEDIA_STORAGE_FORCE_PATH_STYLE=true
# MEDIA_STORAGE_PUBLIC_ORIGIN=https://abstract-usable-gazebo.ruweb.place
# MEDIA_STORAGE_SIGNING_KEY_FILE=/run/secrets/media_storage_signing_key
# MEDIA_STORAGE_ENCRYPTION_KEY_FILE=/run/secrets/media_storage_encryption_key
# MEDIA_STORAGE_KEY_VERSION=1
AUTH_RATE_LIMIT=10
PIN_TRUST_DAYS=30
# Provider-neutral registration gate. Leave disabled until a reviewed adapter is registered.
REGISTRATION_RISK_ENABLED=false
# fail_closed blocks registration when an enabled provider is unavailable; fail_open records an explicit allow reason.
REGISTRATION_RISK_FAILURE_MODE=fail_closed
REGISTRATION_DISPOSABLE_EMAIL_CHECK=true
REGISTRATION_CAPTCHA_MODE=risk_based
REGISTRATION_DENY_RISK_SCORE=0.9
# Comma-separated exact IPs/CIDRs of your reverse proxy. Empty = direct connection only.
TRUSTED_PROXY_CIDRS=
# Optional OpenAI Responses provider. Leave all three empty to disable AI execution.
# AI_API_BASE_URL=https://api.openai.com/v1/
# AI_API_TOKEN=
# AI_MODEL=gpt-6-luna
# Enable only after schema v11 and the current application grants are applied.
# Releases quota reserved by AI operations left processing for more than 15 minutes.
AI_RECONCILIATION_ENABLED=false
