{
    "name": "meal-planner-back",
    "version": "0.0.135",
    "private": true,
    "type": "module",
    "engines": {
        "node": ">=24.19.0 <25",
        "npm": ">=11 <12"
    },
    "packageManager": "npm@11.17.0",
    "scripts": {
        "dev": "node --env-file-if-exists=.local/backend.env --env-file-if-exists=.env --watch dist/src/main.js",
        "build": "tsc -p tsconfig.json",
        "build:watch": "tsc -p tsconfig.json --watch",
        "start": "node --env-file-if-exists=.local/backend.env --env-file-if-exists=.env dist/src/main.js",
        "typecheck": "tsc -p tsconfig.json --noEmit",
        "test": "npm run build && node --test dist/test/*.test.js",
        "test:postgres": "npm run build && node scripts/test-postgres-live.mjs",
        "test:postgres:isolated": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/run-isolated-postgres-acceptance.ps1",
        "lint": "eslint . && prettier --check .",
        "format": "prettier --write .",
        "check": "npm run check:secrets && node scripts/generate-types.mjs --check && npm run typecheck && npm run lint && npm test",
        "openapi": "npm run build && node dist/src/export-openapi.js",
        "db:plan": "node scripts/migrate.mjs",
        "db:migrate": "node scripts/migrate.mjs --apply",
        "audit:dependencies": "npm audit --omit=dev --audit-level=high",
        "db:provision:plan": "node scripts/provision-local.mjs",
        "db:types": "node scripts/generate-types.mjs",
        "ops:news": "node scripts/process-operational-maintenance.mjs news",
        "ops:incidents": "node scripts/process-operational-maintenance.mjs incidents",
        "ops:retention": "node scripts/process-operational-maintenance.mjs retention",
        "ops:sanctions": "node scripts/process-operational-maintenance.mjs sanctions",
        "ops:diary-portions": "node scripts/process-operational-maintenance.mjs diary-portions",
        "ops:topology": "npm run build && node scripts/print-worker-topology.mjs",
        "ops:readiness": "npm run build && node scripts/print-operational-readiness.mjs",
        "legal:readiness": "npm run build && node scripts/print-legal-readiness.mjs",
        "check:secrets": "node scripts/check-secrets.mjs"
    },
    "dependencies": {
        "@fastify/cookie": "11.1.2",
        "@fastify/helmet": "13.1.1",
        "@fastify/multipart": "10.1.2",
        "@fastify/rate-limit": "11.2.0",
        "@nestjs/common": "12.2.0",
        "@nestjs/core": "12.2.0",
        "@nestjs/platform-fastify": "12.2.0",
        "@nestjs/swagger": "12.0.2",
        "fastify": "5.12.7",
        "kysely": "0.29.6",
        "otplib": "13.5.0",
        "pg": "8.23.0",
        "reflect-metadata": "0.2.2",
        "rxjs": "7.8.2",
        "sharp": "0.35.5",
        "tesseract.js": "7.0.0",
        "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz",
        "zod": "4.6.7"
    },
    "devDependencies": {
        "@eslint/js": "10.0.1",
        "@types/node": "24.13.6",
        "@types/pg": "8.23.1",
        "eslint": "10.11.0",
        "globals": "17.12.0",
        "prettier": "3.9.9",
        "typescript": "6.0.3",
        "typescript-eslint": "8.70.1"
    }
}
